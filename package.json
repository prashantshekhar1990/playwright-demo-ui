{
  "name": "playwright-demo-ui",
  "version": "1.0.0",
  "description": "Practice web app covering 15 UI automation scenarios for Playwright",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:ci": "playwright test --config=playwright.ci.config.ts",
    "test:cross-browser": "playwright test --config=playwright.cross-browser.config.ts",
    "test:smoke": "playwright test --grep @smoke",
    "test:codegen": "playwright codegen http://localhost:3000",
    "report": "node scripts/show-latest-report.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
